<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:padding="14dp"
    android:baselineAligned="false">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <TextView android:id="@+id/squares_value"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/squadrat" android:textSize="24sp" android:textStyle="bold"
            android:text="0" />
        <TextView android:id="@+id/squares_label"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#B8C6BE" android:textSize="11sp" android:text="@string/stat_squadrats" />
        <TextView android:id="@+id/squares_delta"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/squadrat" android:textSize="11sp" android:text="+0" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <TextView android:id="@+id/mini_value"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/squadratinho" android:textSize="24sp" android:textStyle="bold"
            android:text="0" />
        <TextView android:id="@+id/mini_label"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#B8C6BE" android:textSize="11sp" android:text="@string/stat_squadratinhos" />
        <TextView android:id="@+id/mini_delta"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/squadratinho" android:textSize="11sp" android:text="+0" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <TextView android:id="@+id/km_value"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/trail" android:textSize="24sp" android:textStyle="bold"
            android:text="0" />
        <TextView android:id="@+id/km_label"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#B8C6BE" android:textSize="11sp" android:text="@string/unit_km" />
        <TextView android:id="@+id/km_delta"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/trail" android:textSize="11sp" android:text="+0" />
    </LinearLayout>

</LinearLayout>
